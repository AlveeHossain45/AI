# ============================================================================
# NovaAI — Environment configuration (copy to .env and fill in values)
# Never commit the real .env file.
# ============================================================================

# ------------------------------- Runtime ----------------------------------
NODE_ENV=development
PORT=4000
# Public URL of the frontend (used for CORS + email links)
CLIENT_URL=http://localhost:5173
# Set to "true" when running behind a reverse proxy (Render/Railway/Fly/VPS+nginx)
TRUST_PROXY=false

# ------------------------------- Database ---------------------------------
# PostgreSQL connection string (Neon / Supabase / Railway / local Postgres)
DATABASE_URL=postgresql://user:password@localhost:5432/novaai
# Optional separate direct URL for migrations (useful with pgbouncer / Neon)
# DIRECT_URL=

# ------------------------------- Vector DB --------------------------------
# pgvector | memory  (memory = dev-only, no persistence, no extra service)
VECTOR_PROVIDER=memory
# Optional dedicated vector database URL; falls back to DATABASE_URL
# VECTOR_DATABASE_URL=

# ------------------------------- Auth -------------------------------------
# REQUIRED in production: long random string (openssl rand -hex 64)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
# Cookie settings (use COOKIE_SAMESITE=none + COOKIE_SECURE=true when the
# frontend and backend run on different domains)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Admin bootstrap (used by `npm run seed` to create the first admin user)
ADMIN_EMAIL=admin@novaai.local
ADMIN_PASSWORD=ChangeMe123!
# Optional Google OAuth (sign in with Google)
# GOOGLE_CLIENT_ID=

# ------------------------------- AI provider -------------------------------
# openai | anthropic | gemini | grounded | mock
#
# "grounded" (default) is NovaAI's built-in answer engine: it needs NO API key
# and answers by retrieving free open sources (Wikipedia, DuckDuckGo, Stack
# Overflow, MDN, Hacker News, arXiv, ...) and synthesising cited, extractive
# answers — plus verified code templates and exact math.
# Switch to openai/anthropic/gemini for generative (LLM) answers.
AI_PROVIDER=grounded
# Model routing: omit to use provider defaults
AI_MODEL=
# Fast model for simple questions
AI_FAST_MODEL=
# Strong model for complex reasoning / deep research
AI_STRONG_MODEL=
# Coding-capable model
AI_CODING_MODEL=
# Large-context model for big documents
AI_LONG_CONTEXT_MODEL=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Optional: any OpenAI-compatible endpoint (Ollama, LM Studio, vLLM, OpenRouter)
# OPENAI_BASE_URL=http://localhost:11434/v1
# Optional: use an LLM to classify question intent instead of heuristics
# INTENT_DETECTION=llm
# Optional: disable the research synthesis pass to save tokens
# RESEARCH_SYNTHESIS=off

# Embeddings for RAG: openai | mock
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ------------------------------- Search provider ---------------------------
# tavily | brave | serper | google | mock
SEARCH_PROVIDER=mock
TAVILY_API_KEY=
BRAVE_API_KEY=
SERPER_API_KEY=
# Google Programmable Search (https://programmablesearchengine.google.com/)
# GOOGLE_SEARCH_API_KEY=
# GOOGLE_SEARCH_CX=
# Fallback to other configured providers when the primary one fails: true/false
SEARCH_FALLBACK=true
# Note: even without any search key, NovaAI still answers from keyless
# knowledge connectors (Wikipedia, Wikidata, DuckDuckGo, Stack Overflow,
# MDN, Hacker News, arXiv, Crossref, OpenAlex, PubMed, Open Library, Gutenberg).

# ------------------------------- Limits ------------------------------------
MAX_FILE_SIZE_MB=20
MAX_UPLOAD_FILES=5
REQUEST_BODY_LIMIT=2mb
RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
CHAT_RATE_LIMIT_WINDOW_MS=60000
CHAT_RATE_LIMIT_MAX=20
STREAM_TIMEOUT_MS=120000
UPSTREAM_TIMEOUT_MS=30000
CONTEXT_MAX_TOKENS=6000
CONTEXT_MAX_MESSAGES=12
MAX_RETRIEVED_CHUNKS=8
MAX_SEARCH_RESULTS=8

# Deep research limits
DEEP_RESEARCH_MAX_SUBQUERIES=4
DEEP_RESEARCH_MAX_SEARCHES=6
DEEP_RESEARCH_MAX_SOURCES=12
DEEP_RESEARCH_MAX_TIME_MS=90000

# Fact-checking layer (requires a real AI provider)
FACT_CHECK_ENABLED=false

# ------------------------------- Features ----------------------------------
# Show the "Sources / Details" disclosure in the UI
SHOW_SOURCES_DEFAULT=true
# Allow clearly-marked Mock providers when no API keys are configured.
# MUST be false in production.
ENABLE_MOCK_PROVIDERS=true
# Maintenance mode: rejects new chat requests with a friendly message
MAINTENANCE_MODE=false

# ------------------------------- Email (optional) ---------------------------
# SMTP connection URL, e.g. smtp://user:pass@smtp.example.com:587
# Without it, verification/reset links are logged to the server console
# and returned in development responses.
SMTP_URL=
EMAIL_FROM="NovaAI <no-reply@novaai.local>"

# ------------------------------- Storage ------------------------------------
# local | s3-compatible (s3 storage requires STORAGE_* below)
STORAGE_PROVIDER=local
# STORAGE_ROOT=./storage
# STORAGE_S3_BUCKET=
# STORAGE_S3_REGION=
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=
# STORAGE_S3_ENDPOINT=

# ------------------------------- Optional: DB control ------------------------
# Set to false to force the in-memory store even if DATABASE_URL is set
# ENABLE_DATABASE=true

# ------------------------------- Optional: polite API usage ------------------
# CROSSREF_MAILTO=you@example.com
# OPENALEX_MAILTO=you@example.com

# ------------------------------- Optional: cost table override ---------------
# COST_TABLE_JSON={"openai":{"gpt-4o":{"input":2.5,"output":10}}}
